# Optional: without Shopify credentials, the site uses demo products (no real checkout).
VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=
# A real public customer support email; contact form opens an email draft.
VITE_CONTACT_EMAIL=
# Optional, currently unused by the storefront.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional public signup endpoint. POST JSON; any 2xx response confirms subscription.
# Leave empty for local-only signup preview. Never put email-service secrets here.
VITE_NEWSLETTER_ENDPOINT=
